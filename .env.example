# Copy this file to .env and fill in your actual API keys.
# Get these from https://developers.kakao.com/

# REST API key — used for routing/directions API calls (server-side)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# JavaScript API key — used for the Kakao Map SDK in the generated HTML
KAKAO_JS_API_KEY=your_kakao_javascript_api_key_here
